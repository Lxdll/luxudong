luxudong.me {
    encode zstd gzip
    reverse_proxy web:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

www.luxudong.me {
    redir https://luxudong.me{uri} permanent
}

